      "name": "editor-shell",
      "type": "registry:ui",
      "title": "Editor Shell",
      "description": "The assembled editor chrome: docked panels on desktop, a drawer on tablets, bottom bar and sheets on phones. Use inside Editor.Root.",
      "dependencies": [
        "@createcms/react@^0.3.2",
