{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "createcms",
  "homepage": "https://createcms.dev",
  "items": [
    {
      "name": "editor-form",
      "type": "registry:ui",
      "title": "Editor Form",
      "description": "Styled wrappers for Editor.Field parts. Does not wrap Editor.Root.",
      "dependencies": ["@createcms/react"],
      "files": [
        {
          "path": "registry/editor-form.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "editor-ring": "var(--ring)",
          "editor-invalid": "var(--destructive)",
          "editor-muted": "var(--muted-foreground)"
        }
      }
    }
  ]
}
