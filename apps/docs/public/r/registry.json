{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "createcms",
  "homepage": "https://createcms.dev",
  "items": [
    {
      "name": "editor-field",
      "type": "registry:ui",
      "title": "Editor Field",
      "description": "Styled wrappers for the Editor.Field parts (label, control, description, error). Use inside Editor.Root.",
      "dependencies": ["@createcms/react@^0.3.2"],
      "files": [
        {
          "path": "registry/editor-field.tsx",
          "type": "registry:component"
        }
      ],
      "registryDependencies": [
        "button",
        "checkbox",
        "input",
        "select",
        "textarea"
      ]
    },
    {
      "name": "editor-form",
      "type": "registry:ui",
      "title": "Editor Form",
      "description": "The styled form of one block and the form-only edit surface. Does not wrap Editor.Root.",
      "dependencies": ["@createcms/react@^0.3.2"],
      "files": [
        {
          "path": "registry/editor-form.tsx",
          "type": "registry:component"
        }
      ],
      "cssVars": {
        "theme": {
          "editor-ring": "var(--ring)",
          "editor-invalid": "var(--destructive)",
          "editor-muted": "var(--muted-foreground)"
        }
      },
      "registryDependencies": ["https://createcms.dev/r/editor-field.json"]
    },
    {
      "name": "editor-canvas",
      "type": "registry:ui",
      "title": "Editor Canvas",
      "description": "Styled wrappers for Canvas overlay and interaction parts. Does not wrap Canvas.Root.",
      "dependencies": ["@createcms/react@^0.3.2", "lucide-react"],
      "registryDependencies": [
        "button",
        "dropdown-menu",
        "separator",
        "tooltip"
      ],
      "files": [
        {
          "path": "registry/editor-canvas.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/editor-canvas.css",
          "type": "registry:style"
        }
      ],
      "cssVars": {
        "theme": {
          "editor-accent": "var(--primary)",
          "editor-accent-secondary": "var(--muted-foreground)",
          "editor-selection": "oklch(from var(--editor-accent) l c h / 0.7)",
          "editor-hover": "color-mix(in oklab, var(--editor-accent-secondary) 40%, transparent)",
          "editor-hover-fill": "color-mix(in oklab, var(--editor-accent) 12%, transparent)",
          "editor-focus": "var(--ring)",
          "editor-drop": "var(--editor-accent)",
          "editor-slot-min-empty-height": "128px",
          "editor-duration-fast": "50ms",
          "editor-duration": "150ms",
          "editor-duration-slow": "250ms"
        }
      },
      "css": {
        "@layer base": {
          "[data-editor-canvas] .sticky, [data-editor-canvas] .fixed": {
            "position": "static"
          },
          "[data-editor-canvas]": {
            "backdrop-filter": "none"
          }
        }
      }
    },
    {
      "name": "editor-chrome",
      "type": "registry:ui",
      "title": "Editor Chrome",
      "description": "Shared state and building blocks of the editor shell parts (device, layout, dialogs, icons, hint buttons).",
      "dependencies": ["@createcms/react@^0.3.2", "lucide-react"],
      "registryDependencies": ["button", "kbd", "tooltip"],
      "files": [
        {
          "path": "registry/editor-chrome.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "editor-toolbar",
      "type": "registry:ui",
      "title": "Editor Toolbar",
      "description": "Top toolbar with history, device frame, add block, command palette (Mod+K) and save. Use inside EditorProvider.",
      "dependencies": ["@createcms/react@^0.3.2", "lucide-react"],
      "registryDependencies": [
        "https://createcms.dev/r/editor-chrome.json",
        "button",
        "command",
        "dialog",
        "input",
        "kbd",
        "separator",
        "sidebar",
        "toggle-group",
        "tooltip"
      ],
      "files": [
        {
          "path": "registry/editor-toolbar.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "editor-palette",
      "type": "registry:ui",
      "title": "Editor Palette",
      "description": "Draggable block palette and the searchable add-block list and dialog. Use inside EditorProvider.",
      "dependencies": ["@createcms/react@^0.3.2", "lucide-react"],
      "registryDependencies": [
        "https://createcms.dev/r/editor-canvas.json",
