{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "createcms",
  "homepage": "https://createcms.dev",
  "items": [
    {
      "name": "editor-form",
      "type": "registry:ui",
      "title": "Editor Form",
      "description": "Styled wrappers for Editor.Field parts and cms field controls. Does not wrap Editor.Root.",
      "dependencies": ["@createcms/react"],
      "registryDependencies": [
        "button",
        "dialog",
        "input",
        "textarea",
        "select",
        "checkbox",
        "media-picker"
      ],
      "files": [
        {
          "path": "registry/editor-form.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/editor-form-cms.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "editor-ring": "var(--ring)",
          "editor-invalid": "var(--destructive)",
          "editor-muted": "var(--muted-foreground)"
        }
      }
    },
    {
      "name": "editor-canvas",
      "type": "registry:ui",
      "title": "Editor Canvas",
      "description": "Styled wrappers for Canvas overlay and interaction parts. Does not wrap Canvas.Root.",
      "dependencies": ["@createcms/react", "lucide-react"],
      "registryDependencies": ["button", "separator", "tooltip"],
      "files": [
        {
          "path": "registry/editor-canvas.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/editor-canvas.css",
          "type": "registry:style"
        }
      ],
      "cssVars": {
        "theme": {
          "editor-selection": "color-mix(in oklab, var(--primary) 55%, transparent)",
          "editor-hover": "color-mix(in oklab, var(--muted-foreground) 40%, transparent)",
          "editor-focus": "var(--ring)",
          "editor-drop": "var(--primary)"
        }
      },
      "css": {
        "@layer base": {
          "[data-editor-canvas] .sticky, [data-editor-canvas] .fixed": {
            "position": "static"
          },
          "[data-editor-canvas]": {
            "backdrop-filter": "none"
          }
        }
      }
    },
    {
      "name": "editor-shell",
      "type": "registry:ui",
      "title": "Editor Shell",
      "description": "Sidebar-grade editor chrome with palette, outline, inspector, and toolbar. Use inside Editor.Root.",
      "dependencies": ["@createcms/react", "lucide-react"],
      "registryDependencies": [
        "editor-form",
        "editor-canvas",
        "button",
        "dialog",
        "input",
        "sidebar",
        "tooltip",
        "command",
        "toggle-group",
        "tabs",
        "separator",
        "kbd",
        "sheet",
        "collapsible"
      ],
      "files": [
        {
          "path": "registry/editor-shell.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "editor-email",
      "type": "registry:ui",
      "title": "Editor Email",
      "description": "Split form and FramePreview layout for email editing. Use inside Editor.Root.",
      "dependencies": ["@createcms/react"],
      "registryDependencies": ["editor-form"],
      "files": [
        {
          "path": "registry/editor-email.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "editor-app",
      "type": "registry:block",
      "title": "Editor App",
      "description": "CMS-wired editor page: document load/save, field sources, shell, and canvas overlays in one install.",
      "dependencies": [
        "@createcms/react",
        "@tiptap/core@3.32.0",
        "@tiptap/pm@3.32.0",
        "@tiptap/starter-kit@3.32.0",
        "@tiptap/extensions@3.32.0",
        "@tiptap/extension-link@3.32.0",
        "@tiptap/suggestion@3.32.0"
      ],
      "registryDependencies": [
        "editor-form",
        "editor-canvas",
        "editor-shell",
        "alert",
        "alert-dialog",
        "button",
        "skeleton"
      ],
      "files": [
        {
          "path": "registry/editor-app.tsx",
          "type": "registry:block"
        }
      ]
    },
    {
      "name": "media-library",
      "type": "registry:ui",
      "title": "Media Library",
      "description": "Styled wrappers for every Media.* part plus MediaLibraryLayout. Does not wrap Media.Root.",
      "dependencies": ["@createcms/react", "lucide-react"],
      "registryDependencies": [
        "button",
        "input",
        "select",
        "dialog",
        "alert",
        "alert-dialog",
        "progress",
        "badge",
        "breadcrumb"
      ],
      "files": [
        {
          "path": "registry/media-library.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "media-selection": "var(--ring)",
          "media-drop": "var(--primary)"
        }
      }
    },
    {
      "name": "media-picker",
      "type": "registry:ui",
      "title": "Media Picker",
      "description": "Dialog control that owns its own Media.Root and returns one selected asset id.",
      "dependencies": ["@createcms/react"],
      "registryDependencies": ["media-library", "dialog", "button"],
      "files": [
        {
          "path": "registry/media-picker.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
