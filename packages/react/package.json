{
  "name": "@createcms/react",
  "version": "0.3.0",
  "description": "Headless, unstyled editor primitives for createcms (shadcn-style: namespace parts, render prop, data-* state, zero runtime dependencies).",
  "keywords": [
    "cms",
    "createcms",
    "editor",
    "headless",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/weepaho3/createCMS#readme",
  "bugs": {
    "url": "https://github.com/weepaho3/createCMS/issues"
  },
  "license": "MIT",
  "author": {
    "name": "weepaho3",
    "url": "https://github.com/weepaho3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weepaho3/createCMS.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./editor/canvas": {
      "types": "./dist/editor/canvas/index.d.ts",
      "default": "./dist/editor/canvas/index.js"
    },
    "./editor/cms": {
      "types": "./dist/editor/cms/index.d.ts",
      "default": "./dist/editor/cms/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee --dts-bundle",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "oxlint",
    "test": "vitest run --maxWorkers=2",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@createcms/schema": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "bunchee": "^7.0.1",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
