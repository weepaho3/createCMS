{
  "name": "@createcms/react",
  "version": "0.3.2",
  "description": "Headless, unstyled editor and media library primitives for createcms (shadcn-style: namespace parts, render prop, data-* state, zero runtime dependencies).",
  "keywords": [
    "cms",
    "createcms",
    "editor",
    "headless",
    "media",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/weepaho3/createCMS#readme",
  "bugs": {
    "url": "https://github.com/weepaho3/createCMS/issues"
  },
  "license": "MIT",
  "author": {
    "name": "weepaho3",
    "url": "https://github.com/weepaho3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weepaho3/createCMS.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./editor/core": {
      "types": "./dist/editor/core/index.d.ts",
      "default": "./dist/editor/core/index.js"
    },
    "./editor/canvas": {
      "types": "./dist/editor/canvas/index.d.ts",
      "default": "./dist/editor/canvas/index.js"
    },
    "./editor/cms": {
      "types": "./dist/editor/cms/index.d.ts",
      "default": "./dist/editor/cms/index.js"
    },
    "./editor/render": {
      "types": "./dist/editor/render/index.d.ts",
      "default": "./dist/editor/render/index.js"
    },
    "./editor/richtext": {
      "types": "./dist/editor/richtext/index.d.ts",
      "default": "./dist/editor/richtext/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee --dts-bundle",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "oxlint",
    "test": "vitest run --maxWorkers=2",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@createcms/schema": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "^4.14.0",
    "bunchee": "^7.0.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.7.2",
    "valibot": "^1.5.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@tiptap/core": "~3.32.0",
    "@tiptap/extension-link": "~3.32.0",
    "@tiptap/extensions": "~3.32.0",
    "@tiptap/pm": "~3.32.0",
    "@tiptap/starter-kit": "~3.32.0",
    "@tiptap/suggestion": "~3.32.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
