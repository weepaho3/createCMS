{
  "name": "@createcms/schema",
  "version": "0.1.0",
  "description": "Shared, runtime-free type vocabulary for createcms blocks, collections and trees, consumed by @createcms/core and @createcms/react.",
  "keywords": [
    "cms",
    "createcms",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/weepaho3/createCMS#readme",
  "bugs": {
    "url": "https://github.com/weepaho3/createCMS/issues"
  },
  "license": "MIT",
  "author": {
    "name": "weepaho3",
    "url": "https://github.com/weepaho3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weepaho3/createCMS.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "oxlint"
  },
  "devDependencies": {
    "bunchee": "^7.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
