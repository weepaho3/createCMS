{
  "name": "@createcms/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, runtime-free type vocabulary for createcms blocks, collections and trees. Consumed by @createcms/core (inlined at build time) and, later, @createcms/react.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bunchee",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "oxlint"
  },
  "devDependencies": {
    "bunchee": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
