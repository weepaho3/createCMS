{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": true,
    "declarationMap": false,
    "esModuleInterop": true
  },
  "include": ["src", "test"],
  // Tests ARE type-checked (check-types = tsc --noEmit): a wrong-signature call
  // in a *.test.ts is caught here, not only at vitest runtime. The build is
  // unaffected — bunchee emits from the package `exports` entries, not from this
  // include set (no test/type-check file reaches dist).
  "exclude": ["node_modules", "dist"]
}
