{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": true,
    "declarationMap": false,
    "esModuleInterop": true,

    // Resolves @createcms/schema to its SOURCE (outside node_modules), not the
    // devDependency package: tsc then needs no prebuilt packages/schema/dist,
    // and bunchee's d.ts bundler (rollup-plugin-dts, respectExternal: false)
    // inlines the schema types into this package's published .d.ts instead of
    // leaving an unresolvable `from '@createcms/schema'` import. The package
    // exports only types, so this alias never affects runtime JS.
    "paths": {
      "@createcms/schema": ["../schema/src/index.ts"]
    }
  },
  "include": ["src"],
  // Tests ARE type-checked (check-types = tsc --noEmit): a wrong-signature call
  // in a *.test.ts is caught here, not only at vitest runtime. The build is
  // unaffected — bunchee emits from the package `exports` entries, not from this
  // include set (no test/type-check file reaches dist).
  "exclude": ["node_modules", "dist"]
}
