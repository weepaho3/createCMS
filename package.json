{
  "name": "createcms",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "check-commit": "node scripts/check-commit-message.mjs",
    "check-types": "turbo check-types",
    "clean": "turbo clean",
    "format": "oxfmt --write",
    "lint": "oxlint --type-aware",
    "release": "changeset publish",
    "test": "turbo test",
    "test:scripts": "node --test scripts/linear-release-attribution.test.mjs",
    "version-packages": "changeset version && node scripts/sync-changelog.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.61.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.8"
  },
  "packageManager": "bun@1.2.23"
}
