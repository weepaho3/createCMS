{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/schema.generated.ts",
    "**/*.type-check.ts",
    "**/*.type-check.tsx",
    "**/*.mdx",
    "apps/docs/public/r/**",
    "tools/oxlint/anti-slop/**"
  ],
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
