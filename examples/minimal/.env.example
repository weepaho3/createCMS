# Environment for the @createcms/core minimal example.
#
# ALL variables below are OPTIONAL. The demo runs on in-process PGlite and
# never uploads media, so each var has a dummy fallback in code — you can run
# `bun run dev` with no .env file at all.
#
# Copy to `.env.local` and fill in real values only if you point the example at
# a real database or an S3-compatible bucket.

# Postgres connection string. Only needed for `bun run db:migrate` against a
# real Postgres — the demo itself runs on in-process PGlite and ignores this.
DATABASE_URL=postgres://user:password@localhost:5432/createcms

# S3-compatible media storage (see lib/cms.ts). The example never uploads, so
# these fall back to dummy values; set them only for a real bucket.
S3_HOSTNAME=localhost
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dummy
S3_SECRET_ACCESS_KEY=dummy
S3_BUCKET=dummy
S3_PUBLIC_URL=https://cdn.example.com
