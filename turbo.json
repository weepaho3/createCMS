{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // The docs-coverage tests (src/**/docs-*.test.ts) read the MDX under
      // apps/docs as an input, so a docs-only edit MUST bust this cache —
      // without the extra input turbo would replay a stale pass and the whole
      // point of the tests (catching docs drift) would be defeated.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/docs/content/docs/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
